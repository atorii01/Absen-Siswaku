<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Baris 1: Kode Rombel + Nama Kelas & Walas + Badge Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Capsule Kode Rombel (cth: "12-RPL", "12-AK1") -->
            <TextView
                android:id="@+id/tvKodeRombel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rombel_code_chip"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:textColor="@color/rombel_code_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="12-RPL" />

            <!-- Nama Kelas & Wali Kelas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaKelas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Kelas XII RPL" />

                <TextView
                    android:id="@+id/tvWaliKelas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    tools:text="Wali: Farauk Pratama, S.Kom" />

            </LinearLayout>

            <!-- Badge Status Rombel: Lengkap vs Perlu Konfirmasi -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_rombel_verif"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/badge_hadir_text"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="✓ Lengkap Terverifikasi" />

        </LinearLayout>

        <!-- Baris 2: Progres Angka & Persentase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgresKehadiran"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="35 / 36 Siswa Hadir" />

            <TextView
                android:id="@+id/tvPersenKehadiran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_teal"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="97.2%" />

        </LinearLayout>

        <!-- Baris 3: Linear Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressRombel"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            app:indicatorColor="@color/primary_teal"
            app:trackColor="@color/input_bg"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="97" />

        <!-- Baris 4: Teks Rincian Mini (Hadir, Sakit/Izin, Alpa) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCountHadir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/badge_hadir_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="● 35 Hadir" />

            <TextView
                android:id="@+id/tvCountIzin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/badge_izin_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="● 1 Sakit/Izin" />

            <TextView
                android:id="@+id/tvCountAlpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/badge_alpa_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="● 0 Alpa" />

        </LinearLayout>

        <!-- Baris 5: 2 Tombol Aksi Sejajar (Audit Foto & GPS vs Rincian Kelas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Tombol Kiri: Audit Foto & GPS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuditGpsFoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="📍 Audit Foto &amp; GPS"
                android:textColor="@color/primary_teal"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/primary_teal"
                app:strokeWidth="1dp" />

            <!-- Tombol Kanan: Rincian Kelas > -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRincianKelas"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="6dp"
                android:text="Rincian Kelas >"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_teal"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
