<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout="@layout/fragment_presensi" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingNavContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/jade_dark_pine"
        app:cardCornerRadius="34dp"
        app:cardElevation="12dp"
        app:strokeColor="#2EFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/dockNavLayout"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <!-- Tab 1: Presensi -->
            <LinearLayout
                android:id="@+id/tabPresensi"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_nav_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/icPresensi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Presensi"
                    android:src="@drawable/ic_nav_presensi"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvPresensi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Presensi"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Tab 2: Riwayat -->
            <LinearLayout
                android:id="@+id/tabRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/icRiwayat"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Riwayat"
                    android:src="@drawable/ic_nav_riwayat"
                    app:tint="#80B7E5BA" />

                <TextView
                    android:id="@+id/tvRiwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Riwayat"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tab 3: Pengajuan -->
            <LinearLayout
                android:id="@+id/tabPengajuan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/icPengajuan"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Pengajuan"
                    android:src="@drawable/ic_nav_pengajuan"
                    app:tint="#80B7E5BA" />

                <TextView
                    android:id="@+id/tvPengajuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Pengajuan"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tab 4: Setelan -->
            <LinearLayout
                android:id="@+id/tabSetelan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/icSetelan"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Setelan"
                    android:src="@drawable/ic_nav_setelan"
                    app:tint="#80B7E5BA" />

                <TextView
                    android:id="@+id/tvSetelan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Setelan"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
