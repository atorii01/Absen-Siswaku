<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Baris Header: Ikon Dokumen Medis, Judul, Tombol Tutup X -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Ikon Dokumen Medis / Surat di kotak bulat biru lembut -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_squircle_blue">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ikon Berkas"
                    android:src="@drawable/ic_medical"
                    app:tint="@color/secondary_blue" />
            </FrameLayout>

            <!-- Judul Header -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvJudulDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lampiran Bukti Ketidakhadiran"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubJudulDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Verifikasi Surat &amp; Dokumen Siswa"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tombol Tutup (X) di Kanan Atas -->
            <FrameLayout
                android:id="@+id/btnCloseHeader"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_setting_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Tutup Dialog"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

        </LinearLayout>

        <!-- Garis Pemisah Halus -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/border_stroke" />

        <!-- Info Siswa & Badge Jenis Izin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNamaSiswa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Bagas Wahyu Santoso • Kelas XII AKL 1" />

            <TextView
                android:id="@+id/tvJenisIzin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill_sakit"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Sakit" />

        </LinearLayout>

        <!-- Area Preview Dokumen / Foto (Card container membulat, tinggi adaptif min 220dp, bg #F1F5F9) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/status_pill_gray_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ImageView Adaptif Penampil Gambar Foto Surat Asli -->
                <ImageView
                    android:id="@+id/ivPratinjauFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="Pratinjau Foto Bukti"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_surat_dokter_preview" />

                <!-- Placeholder / Ikon PDF saat dokumen non-gambar ditampilkan -->
                <LinearLayout
                    android:id="@+id/layoutDokumenPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Ikon Dokumen PDF"
                        android:src="@drawable/ic_pdf_doc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Berkas Lampiran PDF"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tekan tombol di bawah untuk membuka dokumen"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Badge / Pill Nama File di Bagian Bawah Gambar -->
                <LinearLayout
                    android:id="@+id/layoutPillNamaFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_quote_box"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvNamaFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxWidth="260dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="📄 Surat_Keterangan_Sakit.pdf" />
                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Aksi di Bawah Pill Nama File: Buka / Unduh Berkas Dokumen (MaterialButton Teal) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBukaDokumen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary_teal"
            android:text="👁 Buka / Unduh Berkas Dokumen"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="10dp"
            tools:visibility="visible" />

        <!-- Box Keterangan / Alasan Siswa (bg halus #F8F9FF, border 1dp #E2E8F0) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_quote_box"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Kutipan"
                    android:src="@drawable/ic_quote"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Keterangan / Alasan Siswa:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeterangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="italic"
                tools:text="&quot;Demam tinggi sejak semalam, istirahat dokter 2 hari.&quot;" />
        </LinearLayout>

        <!-- Tombol Aksi Bawah: Tutup Pratinjau (Solid Teal atau Outlined) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTutup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/primary_teal"
            android:text="Tutup Pratinjau"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
