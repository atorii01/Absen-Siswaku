<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainGuru"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout="@layout/fragment_guru_presensi" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingNavContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/jade_dark_pine"
        app:cardCornerRadius="34dp"
        app:cardElevation="12dp"
        app:strokeColor="#2EFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/dockNavLayout"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <!-- Tab 1: Presensi Kelas -->
            <LinearLayout
                android:id="@+id/tabGuruPresensi"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_nav_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/icGuruPresensi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Presensi Kelas"
                    android:src="@drawable/ic_bar_chart"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvGuruPresensi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Presensi"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Tab 2: Rekap Absen -->
            <LinearLayout
                android:id="@+id/tabGuruRekap"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/icGuruRekap"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Rekap Absen"
                    android:src="@drawable/ic_calendar"
                    app:tint="#80B7E5BA" />

                <TextView
                    android:id="@+id/tvGuruRekap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Rekap"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tab 3: Setelan -->
            <LinearLayout
                android:id="@+id/tabGuruSetelan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/icGuruSetelan"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Setelan"
                    android:src="@drawable/ic_settings"
                    app:tint="#80B7E5BA" />

                <TextView
                    android:id="@+id/tvGuruSetelan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Setelan"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
