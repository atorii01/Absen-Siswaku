<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Handle Bar Atas Drag Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_pill_gray" />

    <!-- Baris Header Judul & Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubah PIN / Kata Sandi"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Perbarui 6 digit PIN untuk autentikasi presensi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tutup Dialog"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:background="@color/card_stroke" />

    <!-- Form Input: PIN Lama -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="PIN / Kata Sandi Saat Ini*"
        android:textColor="@color/text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPinLama"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        app:boxBackgroundColor="@color/card_bg"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary_teal"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/text_secondary"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/primary_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPinLama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan PIN lama (6 digit)"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Form Input: PIN Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:text="PIN / Kata Sandi Baru*"
        android:textColor="@color/text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPinBaru"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        app:boxBackgroundColor="@color/card_bg"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary_teal"
        app:helperText="Minimal 6 digit angka"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/text_secondary"
        app:startIconDrawable="@drawable/ic_lock_reset"
        app:startIconTint="@color/primary_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPinBaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan PIN baru (6 digit)"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Form Input: Konfirmasi PIN Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:text="Konfirmasi PIN Baru*"
        android:textColor="@color/text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilKonfirmasiPin"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        app:boxBackgroundColor="@color/card_bg"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary_teal"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/text_secondary"
        app:startIconDrawable="@drawable/ic_shield_check"
        app:startIconTint="@color/primary_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKonfirmasiPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ulangi PIN baru"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Progress Bar Loading -->
    <ProgressBar
        android:id="@+id/pbLoadingPin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/primary_teal"
        android:visibility="gone" />

    <!-- Tombol Simpan PIN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpanPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Perbarui PIN Sekarang"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_teal"
        app:cornerRadius="12dp" />

</LinearLayout>