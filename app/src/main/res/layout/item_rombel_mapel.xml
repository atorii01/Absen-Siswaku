<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris 1: Nama Kelas + Badge Persentase Hadir di kiri, Kuota Hadir di kanan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNamaKelas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="XII RPL" />

            <TextView
                android:id="@+id/tvBadgePersentase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_hadir"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/badge_hadir_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="97.2% Hadir" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvKapasitasSiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="0 / 36 Siswa" />

        </LinearLayout>

        <!-- Baris 2: Subteks Wali Kelas -->
        <TextView
            android:id="@+id/tvWaliKelas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Wali Kelas: Farauk Pratama S.Kom" />

        <!-- Baris 3: LinearProgressIndicator Tebal (height 6dp, progressTint @color/primary_teal, trackColor @color/card_stroke) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressKehadiran"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/primary_teal"
            app:trackColor="@color/card_stroke"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <!-- Baris 4: Teks Rincian Mini (● Hadir • ● Izin/Sakit • ● Alpa) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mini Hadir -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_emerald" />

            <TextView
                android:id="@+id/tvCountHadir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/badge_hadir_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="0 Hadir" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- Mini Izin/Sakit -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_amber" />

            <TextView
                android:id="@+id/tvCountIzin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/badge_terlambat_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="0 Izin/Sakit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- Mini Alpa -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_red" />

            <TextView
                android:id="@+id/tvCountAlpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/badge_alpa_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="0 Alpa" />

        </LinearLayout>

        <!-- Baris 5: Tombol Lebar Penuh (btnLihatSiswa): 📄 Lihat Daftar Siswa (Read-Only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLihatSiswa"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary_teal_container"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📄 Lihat Daftar Siswa (Read-Only)"
            android:textAllCaps="false"
            android:textColor="@color/primary_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary_teal"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
