<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Handle Bar Atas Drag Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_pill_gray" />

    <!-- Baris Judul Header & Tombol Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Daftar Presensi XII RPL 1" />

            <TextView
                android:id="@+id/tvDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Status Kehadiran Hari Ini (Read-Only)"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tutup Dialog"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <!-- Banner Ringkasan Kehadiran Rombel (Soft Teal/Blue Container) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/info_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/info_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Info Presensi"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/primary_teal" />

            <TextView
                android:id="@+id/tvSummaryDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/info_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="● 35 Hadir  •  1 Sakit/Izin  •  0 Alpa (Total 36 Siswa)" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Search Box Siswa di Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Cari Siswa"
            android:src="@drawable/ic_search"
            app:tint="@color/text_hint" />

        <EditText
            android:id="@+id/etSearchSiswaDialog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Cari nama atau NISN siswa..."
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnClearSearchSiswa"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Hapus Pencarian"
            android:focusable="true"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_hint" />

    </LinearLayout>

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBarSiswaDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:indeterminateTint="@color/primary_teal"
        android:visibility="gone" />

    <!-- Empty View -->
    <TextView
        android:id="@+id/tvEmptySiswaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="28dp"
        android:gravity="center"
        android:text="Siswa tidak ditemukan."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- RecyclerView Daftar Siswa (Murni Read-Only, Tanpa Tombol Edit/Hapus/Verifikasi) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSiswaDialog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        tools:itemCount="5"
        tools:listitem="@layout/item_siswa_rombel_readonly" />

</LinearLayout>
