<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Baris 1: Kode Rombel + Nama Rombel + Tag Pagi + Ikon Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Box Kode Rombel -->
            <TextView
                android:id="@+id/tvKodeRombelKelola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rombel_code_chip"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary_teal"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="12.RPL" />

            <TextView
                android:id="@+id/tvNamaRombelKelola"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Kelas XII RPL" />

            <!-- Pill Tag Pagi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill_arsip"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="Pagi"
                android:textColor="@color/badge_izin_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Ikon Gerigi Setelan -->
            <ImageButton
                android:id="@+id/btnSettingRombel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Setelan Rombel"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_settings"
                app:tint="#64748B" />

        </LinearLayout>

        <!-- Baris 2: Subteks Wali Kelas -->
        <TextView
            android:id="@+id/tvWaliKelasKelola"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Wali Kelas: Farauk Pratama, S.Kom" />

        <!-- Baris 3: LinearProgressIndicator Kapasitas Kursi -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressKapasitasKursi"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            app:indicatorColor="@color/primary_teal"
            app:trackColor="@color/input_bg"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="100" />

        <!-- Baris 4: Label & Angka Kapasitas Kursi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kapasitas Kursi"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvStatusKapasitasKursi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_teal"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="36 / 36 Siswa (Penuh)" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
