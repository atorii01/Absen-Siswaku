<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llPresensiContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ================= 2a. TOP BAR & HEADER SISWA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Toga SMKN 8"
                    android:src="@drawable/ic_toga"
                    app:tint="@color/primary_teal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMKN 8 Jakarta"
                        android:textColor="@color/primary_teal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTAL SISWA"
                        android:textColor="@color/primary_teal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Siswa Aktif"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTopBarNisn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            tools:text="NISN: 0068192341" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Avatar Siswa"
                        android:src="@drawable/ic_avatar" />

                </LinearLayout>

            </LinearLayout>

            <!-- Baris Status & Tanggal Hari Ini -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Tanggal"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primary_teal" />

                        <TextView
                            android:id="@+id/tvTanggalHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Senin, 12 Mei 2025" />

                        <!-- Badge Status Presensi -->
                        <TextView
                            android:id="@+id/tvBadgeStatusPresensi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill_red"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="BELUM PRESENSI DATANG"
                            android:textColor="@color/status_unread_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Baris Profil Siswa & Batas Masuk -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNamaSiswa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Muhammad Fadhil" />

                            <TextView
                                android:id="@+id/tvKelasNisnSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                tools:text="Kelas 10 IPA 1 • NISN: 0061829103" />

                        </LinearLayout>

                        <!-- Badge Batas Masuk -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill_blue"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Batas Masuk"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvBatasMasukJam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="06:40 WIB"
                                android:textColor="@color/badge_coral_red"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 2b. FRAME KAMERA & DETEKSI AI ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCameraContainer"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Preview View CameraX -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/cameraPreviewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Biometric Face Oval & Focus Brackets Overlay View -->
                    <com.andev.absensiswaku.ui.custom.BiometricOverlayView
                        android:id="@+id/biometricOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <!-- Top Overlay Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <!-- Chip Kiri: Kamera Aktif • Wajah Terdeteksi -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_camera"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot_emerald" />

                            <TextView
                                android:id="@+id/tvStatusKameraChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Kamera Aktif • Wajah Terdeteksi"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Chip Kanan: High-Contrast Face Detection Status Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadgeWarningWajah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/camera_badge_alert_bg"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp"
                            app:strokeColor="@color/camera_badge_alert_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="152dp"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp">

                                <ImageView
                                    android:id="@+id/ivStatusWarningIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="Ikon Status Wajah"
                                    android:src="@drawable/ic_warning"
                                    app:tint="@color/camera_badge_alert_icon_yellow" />

                                <TextView
                                    android:id="@+id/tvStatusWajah"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:shadowColor="#000000"
                                    android:shadowDx="1"
                                    android:shadowDy="1"
                                    android:shadowRadius="2"
                                    android:text="Tidak Terdeteksi"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Bottom Camera Controls Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="16dp">

                        <!-- Kiri: Flashlight / Senter -->
                        <ImageButton
                            android:id="@+id/btnFlashlight"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_camera_action_btn"
                            android:contentDescription="Senter"
                            android:padding="12dp"
                            android:src="@drawable/ic_flash"
                            app:tint="@color/white" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Tengah: Tombol Shutter / Ambil Foto -->
                        <ImageButton
                            android:id="@+id/btnShutter"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_shutter_btn"
                            android:contentDescription="Tombol Shutter"
                            android:padding="12dp"
                            android:src="@drawable/ic_shutter"
                            app:tint="@color/white" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Kanan: Switch Kamera -->
                        <ImageButton
                            android:id="@+id/btnSwitchCamera"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_camera_action_btn"
                            android:contentDescription="Ganti Kamera"
                            android:padding="12dp"
                            android:src="@drawable/ic_camera_switch"
                            app:tint="@color/white" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 2c. KARTU STATUS WAKTU & GEOFENCING GPS ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGpsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Baris 1: Waktu Presensi & Live Digital Clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Ikon Jam"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/primary_teal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Waktu Presensi"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLiveClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_teal"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="17:26:12 WIB" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_stroke" />

                    <!-- Baris 2: Radius GPS & Jarak Real-time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgPinLokasi"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_badge_pill_blue"
                            android:contentDescription="Pin Lokasi"
                            android:padding="6dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/primary_teal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatusRadiusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dalam Radius Sekolah ✓"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatusRadiusSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Gerbang Utama • SMKN 8 Jakarta"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvJarakRealtime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary_teal"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="24 m" />

                            <TextView
                                android:id="@+id/tvAkurasiSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Akurasi ±3m"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Baris 3: Linear Progress Bar Indikator Jarak -->
                    <ProgressBar
                        android:id="@+id/progressBarJarak"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="50"
                        android:progress="24"
                        android:progressDrawable="@drawable/bg_progress_distance" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0m (Gerbang)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPosisiProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Posisi: 24m" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Maks 50m"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Baris 4: Kotak Info Jangkauan 50m -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_info_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Ikon Info"
                            android:src="@drawable/ic_info_circle"
                            app:tint="@color/info_text" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Presensi kehadiran hanya sah dilakukan dalam jangkauan maksimal 50 meter dari area koordinat sekolah."
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 2d. KARTU PRESENSI TERVERIFIKASI OTOMATIS ================= -->
            <LinearLayout
                android:id="@+id/cardVerifiedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_verified_card"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Terverifikasi"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/secondary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Presensi Terverifikasi Otomatis"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Wajah Anda terdeteksi dan lokasi berada dalam radius 50m gerbang sekolah. Data kehadiran Anda langsung tercatat otomatis di sistem sekolah tanpa perlu persetujuan manual guru."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= 2e. TOMBOL CTA UTAMA ================= -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPresensi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/primary_teal"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✓ Presensi Sekarang (Verifikasi Otomatis)"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/white" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>